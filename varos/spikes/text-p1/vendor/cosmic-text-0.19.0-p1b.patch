+        + attrs_bytes(&key.default_attrs)
+        + key.attrs_spans.capacity() * core::mem::size_of::<(Range<usize>, AttrsOwned)>()
+        + key
+            .attrs_spans
+            .iter()
+            .map(|(_, a)| attrs_bytes(a))
+            .sum::<usize>()
+        + glyphs.capacity() * core::mem::size_of::<ShapeGlyph>()
+}
